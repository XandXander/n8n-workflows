      }
    },
    {
      "id": "06000000-0000-4000-8000-000000000003",
      "name": "Read Job",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [680, 300],
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "mode": "id", "value": "PLACEHOLDER_SHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "jobs" },
