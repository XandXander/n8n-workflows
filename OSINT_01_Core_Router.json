а не null): service (услуга из запроса), region (город или \"Россия\"), keywords (2-5 слов), budget_min/budget_max (числа или null), target_url/inn/name (или null).\\n\\nCONFIDENCE: 0.9+ чёткий запрос, 0.5-0.8 неоднозначный.\\n\\nПример: «Найди 5 заявок на монтаж вентфасада в Перми» → { \"intent\": \"search_private\", \"entities\": { \"service\": \"монтаж вентфасада\", \"region\": \"Пермь\", \"keywords\": [\"монтаж\", \"вентфасад\", \"Пермь\"], \"budget_min\": null, \"budget_max\": null, \"target_url\": null, \"target_inn\": null, \"target_name\": null }, \"confidence\": 0.95 }' }, { role: 'user', content: ($json !== undefined ? ($json.raw_text || JSON.stringify($json)).replace(/^(?:OSINT[\\s-]*AI[\\s:]*|Re:[\\s]*|Fwd:[\\s]*)/gi, '').trim().slice(0, 4000) : '{}') } ] }) }}","options":{"timeout":45000,"retryOnFail":true,"maxTries":3,"retryWaitTime":5000}},"name":"DeepSeek Intent Classifier","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[6656,1888],"id":"802a5dc6-83dd-41af-aac3-3cc67b28ee86","credentials":{"httpHeaderAuth":{"id":"R2rXoSacarPbKDqA","name":"DeepSeek API"}},"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const prev = $('Merge After Voice').first()?.json || {};\n\nconst rawContent = $input.first()?.json?.choices?.[0]?.message?.content || '{}';\nlet parsedData;\ntry {\n  const cleanRaw = rawContent.replace(/```json/gi, '').replace(/```/g, '').trim();\n  parsedData = JSON.parse(cleanRaw);\n} catch (e) {\n  parsedData = { intent: 'error', entities: { service: 'ОШИБКА', region: 'ОШИБКА', keywords: [] }, confidence: 0 };\n}\n\nconst job_id = 'job_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 10);\n\nreturn [{\n  json: {\n    job_id: job_id,\n    created_at: new Date().toISOString(),\n    source: prev.source || 'unknown',\n    user_id: prev.user_id || 'unknown',\n    chat_id: prev.chat_id || 'unknown',\n    raw_text: prev.raw_text || '',\n    intent: parsedData.intent || 'error',\n    entities: parsedData