    {
      "parameters": {
        "jsCode": "const cfg = $('Set Config').first().json;\nconst emb = $input.first().json.data?.[0]?.embedding;\nif (!emb) { return [{ json: { error: 'no_embedding', raw: $input.first().json } }]; }\nreturn [{ json: {\n  pinecone_host: cfg.pinecone_host,\n  namespace: cfg.namespace,\n  vector_id: cfg.vector_id,\n  body: { vectors: [ { id: cfg.vector_id, values: emb, metadata: cfg.metadata } ], namespace: cfg.namespace }\n}}];"
      },
