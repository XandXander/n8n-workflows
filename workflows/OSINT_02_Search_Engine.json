    {
      "parameters": {
        "jsCode": "const input = $input.first()?.json || {};\n\nconst job_id = input.job_id || ('job_recovered_' + Date.now().toString(36));\nconst intent = input.intent || 'search_private';\n\nlet entities = input.entities;\nlet attempts = 0;\nwhile (typeof entities === 'string' && attempts < 3) {\n  try { entities = JSON.parse(entities); } catch(e) { entities = {}; break; }\n  attempts++;\n}\nentities = entities || {};\n\nconst service = entities.service || 'услуга';\nconst region = entities.region || 'Россия';\nconst budget_min = entities.budget_min || 0;\nconst budget_max = entities.budget_max || 999999999;\n\nif (service === 'услуга' && !input.intent) {\n  throw new Error(\"Критическая ошибка: Данные не дошли до узла.\");\n}\n\nconst queries = [];\nconst isClientSearch = intent === 'search_private';\n\nif (isClientSearch) {\n  const clientPlatforms = [\n    `\"нужен ${service}\" ${region}`,\n    `\"ищу ${service}\" ${region}`,\n    `\"требуется ${service}\" ${region}`,\n    `\"нужен мастер по ${service}\" ${region}`,\n    `\"посоветуйте ${service}\" ${region}`,\n    `${service} ${region} Авито`,\n    `${service} ${region} Юла`,\n    `${service} ${region} частное лицо ищу`,\n    `${service} ${region} заказать`,\n    `${service} ${region} частный заказ`\n  ];\n  for (const query of clientPlatforms) {\n    queries.push({ json: { query, source_platform: 'general', region, job_id, service, budget_min, budget_max } });\n  }\n} else {\n  const b2bPlatforms = [\n    `${service} ${region} Авито`,\n    `${service} ${region} Юла`,\n    `${service} ${region} Profi`,\n    `${service} ${region} YouDo`,\n    `${service} ищу ${region} ВКонтакте`,\n    `${service} ${region} Telegram заказ`,\n    `${service} ${region} частное лицо`,\n    `${service} ${region} ищу мастера`,\n    `${service} ${region} под ключ`,\n    `${service} ${region} срочно`,\n    `${service} ${region} услуги`,\n    `${service} ${region} цена`,\n    `${service} ${region} частный мастер`,\n    `${service} ${region} заказать`\n  ];\n  for (const query of b2bPlatforms) {\n    queries.push({ json: { query, source_platform: 'general', region, job_id, service, budget_min, budget_max } });\n  }\n}\n\nreturn queries;"
      },
