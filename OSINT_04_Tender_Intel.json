    {
      "id": "04000000-0000-4000-8000-000000000005",
      "name": "Merge Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [920, 400],
      "parameters": { "mode": "append", "options": {} }
    },
    {
      "id": "04000000-0000-4000-8000-000000000006",
      "name": "Extract URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1160, 400],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const all = $input.all();\nconst urls = new Set();\nconst items = [];\nfor (const it of all) {\n  const j = it.json;\n  const organic = j.organic || [];\n  const results = j.results || [];\n  for (const o of organic) {\n    if (o.link && !urls.has(o.link)) { urls.add(o.link); items.push({ url: o.link, title: o.title || '', snippet: o.snippet || '' }); }\n  }\n  for (const r of results) {\n    if (r.url && !urls.has(r.url)) { urls.add(r.url); items.push({ url: r.url, title: r.title || '', snippet: r.content || '' }); }\n  }\n}\nreturn items.slice(0, 25).map(x => ({ json: { ...x, job_id: $('Config').item.json.job_id } }));"
      }
    },
    {
      "id": "04000000-0000-4000-8000-000000000007",
      "name": "Loop Tenders",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1400, 400],
      "parameters": { "batchSize": 3, "options": {} }
    },
    {
      "id": "04000000-0000-4000-8000-000000000008",
      "name": "Firecrawl Scrape Tender",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 400],
      "parameters": {
        "method": "POST",
        "url": "https://api.firecrawl.dev/v1/scrape",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Content-Type", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.url, formats: ['markdown'], onlyMainContent: true, waitFor: 2000, timeout: 45000 }) }}",
        "options": {
          "timeout": 90000,
          "retry": { "enabled": true, "maxTries": 2, "waitBetween": 2000 }
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "PLACEHOLDER_FIRECRAWL", "name": "Firecrawl API" }
      }
    },
    {
      "id": "04000000-0000-4000-8000-000000000009",
      "name": "Parse Tender",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1880, 400],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const md = ($input.item.json.data?.markdown) || $input.item.json.markdown || '';\nconst src = $('Loop Tenders').context.currentItem?.json || {};\nconst budgetM = md.match(/(\\d{1,3}(?:[\\s.,]?\\d{3})+|\\d{4,})\\s*(?:руб|₽|тыс|млн)/i);\nlet budget = 0;\nif (budgetM) {\n  const num = parseInt(budgetM[1].replace(/\\D/g,''), 10);\n  if (/млн/i.test(budgetM[0])) budget = num * 1000000;\n  else if (/тыс/i.test(budgetM[0])) budget = num * 1000;\n  else budget = num;\n}\nconst deadlineM = md.match(/(?:до|окончани[ея]|deadline)[^\\d]{0,30}(\\d{1,2}[\\.\\/-]\\d{1,2}[\\.\\/-]\\d{2,4})/i);\nconst numberM = md.match(/№\\s*([A-Z0-9\\-\\/]+)/i) || md.match(/(?:извещени[ея]|тендер|закупк[иа])\\s*№?\\s*([A-Z0-9\\-\\/]+)/i);\nreturn [{ json: {\n  tender_id: 'tnd_' + Date.now().toString(36) + Math.random().toString(36).slice(2,6),\n  job_id: $('Config').item.json.job_id,\n  platform: new URL(src.url).hostname,\n  tender_number: numberM ? numberM[1] : '',\n  title: src.title || '',\n  budget: budget,\n  deadline: deadlineM ? deadlineM[1] : '',\n  url: src.url,\n  markdown_short: md.slice(0, 3000),\n  scraped_at: new Date().toISOString()\n}}];"
      }
    },
    {
      "id": "04000000-0000-4000-8000-000000000010",
      "name": "Filter Budget",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2120, 400],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
