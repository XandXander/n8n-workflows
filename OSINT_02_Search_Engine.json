{"id":"fgf3zI8fRJhkqlHC","name":"OSINT_02_Search_Engine","nodes":[{"parameters":{"inputSource":"passthrough"},"id":"42b4ac87-bc79-4406-82ae-4b3d34442d29","name":"Trigger","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[-368,1072]},{"parameters":{"jsCode":"const input=$input.first().json;const job_id=input.job_id||'unknown';let entities=input.entities;if(typeof entities==='string'){try{entities=JSON.parse(entities);}catch(e){entities={};}}entities=entities||{};const service=entities.service||'услуга';const region=entities.region||'Россия';const budget_min=entities.budget_min||0;const budget_max=entities.budget_max||999999999;let keywordsList=[];if(Array.isArray(entities.keywords)){keywordsList=entities.keywords;}else if(typeof entities.keywords==='string'&&entities.keywords){keywordsList=entities.keywords.split(',').map(k=>k.trim());}const queries=[];const platforms=[{template:`site:avito.ru \"${service}\" ${region}`,source:'avito.ru'},{template:`site:youla.ru \"${service}\" ${region}`,source:'youla.ru'},{template:`site:vk.com ${service} ищу ${region}`,source:'vk.com'},{template:`site:t.me ${service} ${region}`,source:'t.me'},{template:`\"${service}\" ${region} частное лицо ищу мастера`,source:'general'},{template:`\"${service}\" ${region} нужен специалист заказ`,source:'general'}];for(const p of platforms){queries.push({query:p.template,source_platform:p.source,region:region,job_id:job_id,service:service,budget_min:budget_min,budget_max:budget_max});}for(const kw of keywordsList.slice(0,2)){queries.push({query:`\"${kw}\" ${service} ${region} заказать`,source_platform:'general',region:region,job_id:job_id,service:service,budget_min:budget_min,budget_max:budget_max});}return queries.map(q=>({json:q}));"},"id":"cbc7833b-b085-48e7-971d-f5b3102b32c3","name":"Build Query Matrix","type":"n8n-nodes-base.code","typeVersion":2,"position":[-160,1072]},{"parameters":{"options":{"batchSize":7}},"id":"ea749127-ca2f-4448-bf13-4001693acc6b","name":"Loop