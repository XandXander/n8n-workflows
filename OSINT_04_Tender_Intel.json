            { "id": "c2", "leftValue": "={{ $json.budget }}", "rightValue": "={{ $('Config').item.json.budget_max }}", "operator": { "type": "number", "operation": "lte" } }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "04000000-0000-4000-8000-000000000011",
      "name": "Groq Tender Relevance",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2360, 400],
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
