        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Content-Type", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama-3.3-70b-versatile', temperature: 0.2, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Оцени релевантность тендера нашим услугам (проектирование инженерных систем, вентиляция, кондиционирование, отопление, фасады, AI, автоматизация, видео, графика). Верни СТРОГО JSON: {relevance_score: 0-100, matched_service, win_probability: 0-1, required_prerequisites: string[], summary_ru: string}.' }, { role: 'user', content: JSON.stringify($json).slice(0, 5000) } ] }) }}",
        "options": {
          "timeout": 60000,
          "retry": { "enabled": true, "maxTries": 3, "waitBetween": 3000 }
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "PLACEHOLDER_GROQ", "name": "Groq API" }
      }
    },
    {
      "id": "04000000-0000-4000-8000-000000000012",
      "name": "Enrich Tender",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2600, 400],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const raw = $input.item.json.choices?.[0]?.message?.content || '{}';\nlet p = {}; try { p = JSON.parse(raw); } catch(e) { p = {}; }\nconst t = $('Parse Tender').item.json;\nreturn [{ json: {\n  ...t,\n  relevance_score: p.relevance_score || 0,\n  matched_service: p.matched_service || '',\n  win_probability: p.win_probability || 0,\n  required_prerequisites: (p.required_prerequisites || []).join('; '),\n  summary: p.summary_ru || '',\n  total_score: p.relevance_score || 0\n}}];"
      }
    },
    {
      "id": "04000000-0000-4000-8000-000000000013",
      "name": "Filter Relevance",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2840, 400],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [ { "id": "c1", "leftValue": "={{ $json.relevance_score }}", "rightValue": 50, "operator": { "type": "number", "operation": "gte" } } ],
          "combinator": "and"
        },
        "options": {}
      }
    },
