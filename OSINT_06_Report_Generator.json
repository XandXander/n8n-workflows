    {
      "id": "06000000-0000-4000-8000-000000000002",
      "name": "Set Vars",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 400],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "job_id", "value": "={{ $json.job_id }}", "type": "string" },
            { "id": "2", "name": "entity_type", "value": "={{ $json.entity_type || 'lead' }}", "type": "string" }
          ]
