      "parameters": {
        "jsCode": "// WF5 V4 — advisory scoring only. Deterministic proof fields are never rewritten here.\nconst item = $input.first();\nconst entity = (($('Loop Entities').item || {}).json) || {};\nconst entityType = (($('Set Job Vars').first().json || {}).entity_type || 'lead').toString();\nconst idKey = entityType === 'company' ? 'company_id' : (entityType === 'tender' ? 'tender_id' : 'lead_id');\nconst identity = {};\nidentity[idKey] = entity[idKey] ?? '';\nidentity.job_id = entity.job_id ?? (($('Set Job Vars').first().json || {}).job_id ?? '');\n\nfunction quarantine() {\n  return [{ json: {\n    ...identity,\n    status: 'quarantined',\n    advisory_score_status: 'QUARANTINED'\n  }}];\n}\n\nif (!item || !item.json) return quarantine();\nconst raw = item.json;\nif (!Array.isArray(raw.choices) || raw.choices.length === 0) return quarantine();\nconst content = raw.choices[0]?.message?.content;\nif (typeof content !== 'string' || content.trim() === '') return quarantine();\n\nlet p;\ntry {\n  const clean = content.trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/i, '').trim();\n  p = JSON.parse(clean);\n} catch (e) {\n  return quarantine();\n}\nconst fields = ['relevance_score','freshness_score','solvency_score','contactability_score'];\nfor (const f of fields) {\n  if (p[f] === undefined || p[f] === null) return quarantine();\n  const x = Number(p[f]);\n  if (!Number.isFinite(x) || x < 0 || x > 100) return quarantine();\n}\nconst rel = Number(p.relevance_score);\nconst fresh = Number(p.freshness_score);\nconst sol = Number(p.solvency_score);\nconst con = Number(p.contactability_score);\nconst total = Math.round(0.35*rel + 0.20*fresh + 0.25*sol + 0.20*con);\nreturn [{ json: {\n  ...identity,\n  relevance_score: rel,\n  freshness_score: fresh,\n  solvency_score: sol,\n  contactability_score: con,\n  total_score: total,\n  why_relevant: String(p.why_relevant || ''),\n  recommended_action: String(p.recommended_action || ''),\n  first_message_draft: String(p.first_message_draft || ''),\n  status: total >= 60 ? 'qualified' : 'new',\n  advisory_score_status: 'SCORED'\n}}];"
      },
