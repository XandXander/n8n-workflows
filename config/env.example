# Пример .env файла для OSINT Platform
# Скопируйте в .env и замените <REDACTED> на реальные значения.
# НИКОГДА не коммитьте .env в Git!

# n8n
N8N_ENCRYPTION_KEY=<REDACTED>
N8N_API_ENABLED=true
N8N_BINARY_DATA_MODE=filesystem
N8N_EXECUTION_MODE=regular
N8N_SAVE_EXECUTION_SUCCESS=none
N8N_SAVE_EXECUTION_FAILED=all
N8N_MAX_CONCURRENT_EXECUTIONS=5
N8N_PAYLOAD_SIZE_MAX=32
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_HOST=xandai.ru
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://xandai.ru

# PostgreSQL
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=<REDACTED>

# Redis
QUEUE_BULL_REDIS_HOST=redis

# Execution pruning
N8N_EXECUTIONS_DATA_PRUNE=true
N8N_EXECUTIONS_DATA_MAX_AGE=336

# API ключи (только для справки, реальные значения НЕ хранить здесь)
# DeepSeek API: <REDACTED>
# Serper API: <REDACTED>
# Firecrawl API: <REDACTED>
