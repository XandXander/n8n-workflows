{"id":"qXWixFd94G7Tfgaa","name":"OSINT_06_Report_Generator","nodes":[{"parameters":{},"id":"b675a9d5-2a62-4719-afcd-c23d6248bcff","name":"Start","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1,"position":[-448,112]},{"parameters":{"assignments":{"assignments":[{"id":"1","name":"job_id","value":"={{ $json.job_id }}","type":"string"},{"id":"2","name":"entity_type","value":"={{ $json.entity_type || 'lead' }}","type":"string"}]},"options":{}},"id":"317b1089-8308-469d-94c9-d2282d835d0d","name":"Set Vars","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-224,112]},{"parameters":{"documentId":{"__rl":true,"mode":"id","value":"1BddnyOBG8Q0BYpXoE0QFkJG2pJi_oxk0aLfJ86IggXA"},"sheetName":{"__rl":true,"mode":"name","value":"jobs"},"filtersUI":{"values":[{"lookupColumn":"=job_id","lookupValue":"={{ $json.job_id }}"}]},"options":{}},"id":"9b90d27a-4983-477d-b900-fe7b49449cf8","name":"Read Job","type":"n8n-nodes-base.googleSheets","typeVersion":4.5,"position":[0,0],"credentials":{"googleSheetsOAuth2Api":{"id":"dUZaJdXfgHXwnmNN","name":"Google Sheets account"}}},{"parameters":{"documentId":{"__rl":true,"mode":"id","value":"1BddnyOBG8Q0BYpXoE0QFkJG2pJi_oxk0aLfJ86IggXA"},"sheetName":{"__rl":true,"value":"gid=0","mode":"list","cachedResultName":"jobs","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1BddnyOBG8Q0BYpXoE0QFkJG2pJi_oxk0aLfJ86IggXA/edit#gid=0"},"options":{}},"id":"b3756a02-cd8c-4d7a-bbae-e08b54ff1b1d","name":"Read Qualified Entities","type":"n8n-nodes-base.googleSheets","typeVersion":4.5,"position":[0,208],"credentials":{"googleSheetsOAuth2Api":{"id":"dUZaJdXfgHXwnmNN","name":"Google Sheets account"}}},{"parameters":{"jsCode":"const job = $('Read Job').first()?.json || {};\nconst entities = $('Read Qualified Entities').all().map(i => i.json);\nconst qualified = entities.filter(e => (Number(e.total_score) || 0) >= 60).sort((a,b) => (Number(b.total_score)||0) - (Number(a.total_score)||0)).slice(0, 20);\nconst stats = {\n  total_found: entities.length,\n  qualified: qualified.length,\n  avg_score: entities.length ? Math.round(entities.reduce((s,e)=>s+(Number(e.total_score)||0),0)/entities.length) : 0\n};\nreturn [{ json: { job, entities: qualified, stats, entity_type: $('Set Vars').item.json.entity_type } }];"},"id":"9c1baa63-a294-40e1-9948-102cc5f4a424","name":"Prepare Context","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,112]},{"parameters":{"method":"POST","url":"https://api.deepseek.com/chat/completions","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ model: 'deepseek-chat-v4-flash', temperature: 0.4, max_tokens: 4000, messages: [ { role: 'system', content: 'Ты аналитик OSINT. Сгенерируй ПРОФЕССИОНАЛЬНЫЙ отчёт на русском в Markdown. Структура: # Отчёт по запросу; ## 1. Резюме; ## 2. Ключевые метрики (таблица); ## 3. Топ-10 (для каждого: название, платформа, контакты, бюджет, скор, почему релевантен, первый месседж, ссылка на источник); ## 4. Компании/Тендеры (если есть); ## 5. Рекомендации; ## 6. Следующие шаги. Для каждого пункта Топ-10 обязательно укажи ссылку на источник (source_url). Пиши профессионально, конкретно, без воды.' }, { role: 'user', content: JSON.stringify($json).slice(0, 10000) } ] }) }}","options":{"timeout":90000}},"id":"4d12529d-4bc9-4a29-9e24-6a038fe90d6c","name":"DeepSeek Generate MD","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[480,112],"credentials":{"httpHeaderAuth":{"id":"R2rXoSacarPbKDqA","name":"DeepSeek API"}}},{"parameters":{"jsCode":"const md = $input.item.json.choices?.[0]?.message?.content || '';\nfunction mdToHtml(s){\n  let h = s;\n  h = h.replace(/^### (.*)$/gm,'<h3>$1</h3>');\n  h = h.replace(/^## (.*)$/gm,'<h2>$1</h2>');\n  h = h.replace(/^# (.*)$/gm,'<h1>$1</h1>');\n  h = h.replace(/\\*\\*(.+?)\\*\\*/g,'<strong>$1</strong>');\n  h = h.replace(/\\*(.+?)\\*/g,'<em>$1</em>');\n  h = h.replace(/`([^`]+)`/g,'<code>$1</code>');\n  h = h.replace(/^\\|(.+)\\|$/gm,(m)=>{const cells=m.slice(1,-1).split('|').map(c=>c.trim());return '<tr>'+cells.map(c=>'<td>'+c+'</td>').join('')+'</tr>';});\n  h = h.replace(/(<tr>[\\s\\S]+?<\\/tr>)/g,'<table>$1</table>');\n  h = h.replace(/^- (.*)$/gm,'<li>$1</li>');\n  h = h.replace(/(<li>[\\s\\S]+?<\\/li>)/g,'<ul>$1</ul>');\n  h = h.replace(/\\n\\n/g,'</p><p>');\n  return '<p>' + h + '</p>';\n}\nconst body = mdToHtml(md);\nconst jobId = $('Set Vars').item.json.job_id;\nconst date = new Date().toISOString().slice(0,10);\nconst html = `<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><title>OSINT ${jobId}</title><style>body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;max-width:800px;margin:40px auto;padding:20px;color:#222;line-height:1.6}h1{color:#1a365d;border-bottom:2px solid #1a365d;padding-bottom:8px}h2{color:#2c5282;margin-top:32px}h3{color:#2b6cb0}table{border-collapse:collapse;width:100%;margin:16px 0}td,th{border:1px solid #ddd;padding:8px 12px;text-align:left}tr:nth-child(even){background:#f7fafc}code{background:#edf2f7;padding:2px 6px;border-radius:3px;font-family:'SF Mono',Monaco,monospace}ul{padding-left:24px}.footer{margin-top:60px;padding-top:20px;border-top:1px solid #e2e8f0;color:#718096;font-size:12px}</style></head><body>${body}<div class=\"footer\">OSINT Report • Job: ${jobId} • Сгенерировано ${date}</div></body></html>`;\nreturn [{ json: { html, md, filename: `OSINT_${jobId}_${date}.pdf`, job_id: jobId } }];"},"id":"3e7c7384-7e80-4cad-8a98-487ffddd58c0","name":"MD to HTML","type":"n8n-nodes-base.code","typeVersion":2,"position":[720,112]},{"parameters":{"method":"POST","url":"http://gotenberg:3000/forms/chromium/convert/html","sendBody":true,"contentType":"multipart-form-data","bodyParameters":{"parameters":[{"parameterType":"formBinaryData","name":"files","inputDataFieldName":"index.html"},{"name":"