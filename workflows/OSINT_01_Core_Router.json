айтов» → { \"intent\": \"search_private\", \"entities\": { \"service\": \"создание сайтов\", \"region\": \"Россия\", \"keywords\": [\"создание сайтов\", \"разработка\"], \"budget_min\": null, \"budget_max\": null, \"target_url\": null, \"target_inn\": null, \"target_name\": null }, \"confidence\": 0.95 }' }, { role: 'user', content: ($json !== undefined ? ($json.raw_text || JSON.stringify($json)).slice(0, 4000) : '{}') } ] }) }}","options":{"timeout":45000,"retryOnFail":true,"maxTries":3,"retryWaitTime":5000}},"name":"DeepSeek Intent Classifier","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[6656,1888],"id":"802a5dc6-83dd-41af-aac3-3cc67b28ee86","credentials":{"httpHeaderAuth":{"id":"R2rXoSacarPbKDqA","name":"DeepSeek API"}}},{"parameters":{"jsCode":"const prev = $('Merge After Voice').first()?.json || {};\n\n// Детектим пустой ответ DeepSeek — кидаем throw для ретрая\nconst rawContent = $input.first()?.json?.choices?.[0]?.message?.content;\nif (!rawContent || rawContent.trim() === '') {\n  throw new Error(\"DeepSeek Intent Classifier вернул пустой ответ. Сработает retryOnFail.\");\n}\n\nlet parsedData;\ntry {\n  const cleanRaw = rawContent.replace(/```json/gi, '').replace(/```/g, '').trim();\n  parsedData = JSON.parse(cleanRaw);\n} catch (e) {\n  throw new Error(\"Не удалось распарсить ответ DeepSeek: \" + rawContent.slice(0, 200));\n}\n\nconst job_id = 'job_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 10);\nreturn [{ json: {\n  job_id, created_at: new Date().toISOString(),\n  source: prev.source || 'unknown', user_id: prev.user_id || 'unknown', chat_id: prev.chat_id || 'unknown',\n  raw_text: prev.raw_text || '', intent: parsedData.intent || 'error', entities: parsedData.entities || {}, confidence: parsedData.confidence || 0, status: 'processing'\n}}];"},"name":"Parse Intent","type":"n8n-nodes-base.code","typeVersion":2,"position":[6880,1888],"id":"d9ffd9e0-cade-4d13-ba41-3b8a3f95bb32"},{"parameters":{"conditions":{"op