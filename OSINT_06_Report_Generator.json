    {
      "id": "06000000-0000-4000-8000-000000000010",
      "name": "Telegram Send PDF",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2120, 300],
      "parameters": {
        "operation": "sendDocument",
        "chatId": "={{ $('Read Job').first().json.user_id }}",
        "binaryData": true,
        "binaryPropertyName": "data",
        "additionalFields": {
          "caption": "=📊 *OSINT Отчёт готов*\n\n*Job*: `{{ $('Set Vars').item.json.job_id }}`\n*Найдено*: {{ $('Prepare Context').item.json.stats.total_found }}\n*Квалифицировано*: {{ $('Prepare Context').item.json.stats.qualified }}\n*Средний скор*: {{ $('Prepare Context').item.json.stats.avg_score }}",
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
        "telegramApi": { "id": "PLACEHOLDER_TELEGRAM", "name": "Telegram Bot" }
      }
    },
    {
      "id": "06000000-0000-4000-8000-000000000011",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [2120, 500],
      "parameters": {
        "fromEmail": "PLACEHOLDER_FROM@yandex.ru",
        "toEmail": "={{ $('Read Job').first().json.user_email || 'PLACEHOLDER_DEFAULT_EMAIL' }}",
        "subject": "=OSINT Report {{ $('Set Vars').item.json.job_id }}",
        "emailFormat": "html",
        "html": "=<h2>Отчёт OSINT-платформы</h2><p>Job ID: <code>{{ $('Set Vars').item.json.job_id }}</code></p><p>Найдено: {{ $('Prepare Context').item.json.stats.total_found }}, квалифицировано: {{ $('Prepare Context').item.json.stats.qualified }}</p><p>PDF: <a href=\"{{ $('Upload to Drive').item.json.webViewLink }}\">Открыть в Google Drive</a></p>",
        "options": {}
      },
      "credentials": {
        "smtp": { "id": "PLACEHOLDER_SMTP", "name": "Yandex SMTP" }
      }
    },
    {
      "id": "06000000-0000-4000-8000-000000000012",
      "name": "Log Report",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [2360, 400],
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "PLACEHOLDER_SHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "reports" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
