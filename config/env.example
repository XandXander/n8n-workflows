# DaData API: <REDACTED>
# Jina API: <REDACTED>
# Pinecone API: <REDACTED>
# Groq API: <REDACTED>
# Google Sheets: <REDACTED>
# Google Drive: <REDACTED>
# Telegram Bot Token: <REDACTED>
# Yandex SMTP: <REDACTED>
# IMAP: <REDACTED>

# Admin
ADMIN_CHAT_ID=<REDACTED>
TELEGRAM_BOT_TOKEN=<REDACTED>
