ce_file_id = msg.voice.file_id;\n      n.raw_text = msg.caption || '';\n    } else {\n      n.raw_text = msg?.text || msg?.caption || '';\n    }\n  }\n  // === EMAIL ===\n  else if (data.subject !== undefined || data.from) {\n    n.source = 'email';\n    const fa = data.from?.value?.[0]?.address || data.from?.text || data.from || 'email_user';\n    n.user_id = typeof fa === 'string' ? fa : 'email_user';\n    n.chat_id = null;\n    // Склеиваем subject + body (OSINT-AI: сохраняется — нужно для фильтрации)\n    n.raw_text = (data.subject || '') + ' ' + (data.text || data.textPlain || '');\n  }\n  // === SHEETS / MANUAL ===\n  else if (data.raw_text) {\n    n.source = 'sheets';\n    n.user_id = data.user_id || 'sheets_user';\n    n.chat_id = data.chat_id || null;\n    n.raw_text = data.raw_text || '';\n  }\n\n  if (n.raw_text || n.voice_file_id) {\n    results.push({ json: n });\n  }\n}\n\nreturn results.length > 0 ? results : [{\n  json: {\n    source: 'empty',\n    raw_text: '',\n    user_id: null,\n    chat_id: null,\n    voice_file_id: null,\n    timestamp: new Date().toISOString()\n  }\n}];"},"name":"Normalize Input","type":"n8n-nodes-base.code","typeVersion":2,"position":[5344,1888],"id":"7c60c5c6-3c1c-420a-93a9-6af098f2fd83"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"vc","leftValue":"={{ $json.voice_file_id }}","rightValue":"","operator":{"type":"string","operation":"isNotEmpty"}}],"combinator":"and"},"options":{}},"name":"Has Voice?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[5568,1888],"id":"6e3664dd-3cba-44f3-9f00-6b65fe7fe974"},{"parameters":{"workflowId":{"__rl":true,"value":"IR4oQQAYQgUwIUjJ","mode":"id"},"workflowInputs":{"mappingMode":"defineBelow","value":{"operation":"stt","file_id":"={{ $json.voice_file_id }}","user_id":"={{ $json.user_id }}","chat_id":"={{ $json.chat_id }}"}},"options":{"waitForSubWorkflow":true}},"name":"Execute STT","type":"n