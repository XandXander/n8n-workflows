{"id":"zcpU6hLvcMl5RiUa","name":"OSINT_04_Tender_Intel","nodes":[{"parameters":{"inputSource":"passthrough"},"id":"19780cf2-b31b-43c1-ad7c-e1cf523f6489","name":"Start","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1.1,"position":[544,48]},{"parameters":{"jsCode":"const input=$input.first().json;let entities=input.entities;if(typeof entities==='string'){try{entities=JSON.parse(entities);}catch(e){entities={};}}entities=entities||{};return[{json:{job_id:input.job_id||'unknown',service:entities.service||'проектирование',region:entities.region||'Россия',budget_min:entities.budget_min||0,budget_max:entities.budget_max||999999999,keywords:Array.isArray(entities.keywords)?entities.keywords.join(' '):(entities.keywords||'')}}];"},"id":"4f2c193d-6beb-43fe-b5a3-ab7802c14d63","name":"Config","type":"n8n-nodes-base.code","typeVersion":2,"position":[768,48]},{"parameters":{"method":"POST","url":"https://google.serper.dev/search","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({q: $json.service + ' ' + $json.region + ' тендер закупки', gl: 'ru', hl: 'ru', num: 15}) }}","options":{"timeout":30000}},"id":"11051cee-af81-4ca3-a56f-c6d3d5eb5a0d","name":"Serper Zakupki","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[976,-64],"credentials":{"httpHeaderAuth":{"id":"utDIwjM5qgsLEmjJ","name":"serper.dev API"}},"onError":"continueRegularOutput"},{"parameters":{"method":"POST","url":"https://api.tavily.com/search","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({query:'тендер '+$json.service+' '+$json.region,search_depth:'advanced',max_results:15,include_domains:['rts-tender.ru','b2b-center.ru','tenderland.ru','tender.pro','zakupki.gov.ru']}) }}","options":{"timeout":30000}},"id":"b45749e4-6e9a-4b99-9009-90261cf7d74f","name":"Tavily Tenders","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[976,144],"credentials":{"httpHeaderAuth":{"id":"Vt4wRogDLlezpXOy","name":"Tavily API"}},"onError":"continueRegularOutput"},{"parameters":{},"id":"f64a4405-d282-47b2-8a87-2e3ca9fe7ffb","name":"Merge Sources","type":"n8n-nodes-base.merge","typeVersion":3.1,"position":[1200,48]},{"parameters":{"jsCode":"const urls=new Set();const items=[];const allowedDomains=['zakupki.gov.ru','rts-tender.ru','b2b-center.ru','tenderland.ru','tender.pro','roseltorg.ru','sberbank-ast.ru'];const inputItems=$input.all()||[];for(const item of inputItems){if(!item||!item.json)continue;const j=item.json;const organic=j.organic||[];const results=j.results||[];for(const o of organic){const link=o.link;if(!link||urls.has(link))continue;const isTender=allowedDomains.some(d=>link.includes(d));if(isTender){urls.add(link);items.push({json:{url:link,title:o.title||'',snippet:o.snippet||''}});}}for(const r of results){const link=r.url;if(!link||urls.has(link))continue;const isTender=allowedDomains.some(d=>link.includes(d));if(isTender){urls.add(link);items.push({json:{url:link,title:r.title||'',snippet:r.content||''}});}}}return items.slice(0,5).length>0?items.slice(0,5):[{json:{skip:true}}];"},"id":"6cec14bd-b39f-4f3c-80db-c9d2d6d69f4e","name":"Extract URLs","type":"n8n-nodes-base.code","typeVersion":2,"position":[1424,48]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":2},"conditions":[{"id":"sk","operator":{"type":"boolean","operation":"notEqual"},"leftValue":"={{ $json.skip === true }}","rightValue":"={{ true }}"},{"id":"8c3dadb7-4bda-4e27-ae44-9976a8efce6e","leftValue":"={{ $json.url }}","rightValue":"","operator":{"type":"string","operation":"notEmpty","singleValue":true}}],"combinator":"and"},"looseTypeValidation":true,"options":{}},"id":"3422d227-2fba-4d38-8d60-7fbbb1b7e225","name":"Filter Skip","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1648,48]},{"parameters":{"options":{}},"id":"263bfcde-980c-415f-9cf8-00dd925fa7c5","name":"Loop Tenders","type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[1888,96]},{"parameters":{"method":"POST","url":"https://api.firecrawl.dev/v1/scrape","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({url:$json.url,formats:['markdown'],onlyMainContent:true,timeout:45000}) }}","options":{"timeout":90000}},"id":"54bcff59-9d89-4be8-9166-9849f05c623a","name":"Firecrawl Scrape","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2080,144],"credentials":{"httpHeaderAuth":{"id":"SEkiK8JUUHNJGpjf","name":"Firecrawl API"}},"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const md=($input.item.json.data?.markdown)||$input.item.json.markdown||'';const cur=$('Loop Tenders').context.currentItem?.json||{};const cfg=$('Config').item.json;const budgetM=md.match(/([\\d\\s.,]+)\\s*(?:руб|\u20bd|тыс|млн)/i);let budget=0;if(budgetM&&budgetM[1]){const num=parseInt(budgetM[1].replace(/\\D/g,''),10)||0;if(/млн/i.test(budgetM[0]))budget=num*1000000;else if(/тыс/i.test(budgetM[0]))budget=num*1000;else budget=num;}const deadlineM=md.match(/(?:до|окончани[ея]|deadline)[\\s\\S]{0,50}?(\\d{1,2}[\\.\\/-]\\d{1,2}[\\.\\/-]\\d{2,4})/i);const numberM=md.match(/№\\s*([А-ЯA-Z0-9\\-\\/]{5,})/i);const titleM=md.match(/^#\\s+(.+)$/m);let hostname='unknown';const rawUrl=cur.url||'';const hostMatch=rawUrl.match(/^(?:https?:\\/\\/)?(?:www\\.)?([^\\/]+)/i);if(hostMatch&&hostMatch[1])hostname=hostMatch[1];return[{json:{tender_id:'tnd_'+Date.now().toString(36)+Math.random().toString(36).slice(2,6),job_id:cfg.job_id,platform:hostname,url:rawUrl,title:titleM?titleM[1]:(cur.title||''),budget:budget,deadline:deadlineM?deadlineM[1]:null,tender_number:numberM?numberM[1]:null,raw_content:md.slice(0,3000)}}];"},"id":"728a520e-74b4-43f9-a0ba-4bda4e9546db","name":"Parse Tender","type":"n8n-nodes-base.code","typeVersion":2,"position":[2304,144]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":1},"conditions":[{"id":"b1","leftValue":"={{ $json.budget }}","rightValue":"={{ $('Config').item.json.budget_max }}","operator":{"type":"number","operation":"lte"}}],"combinator":"and"},"options":{}},"id":"ab2840b5-22ac-4a72-9250-a8f01a9dd866","name":"Filter Budget","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[2528,144]},{"parameters":{"method":"POST","url":"https://api.deepseek.com/chat/completions","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"},{"name":"Connection","value":"keep-alive"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ model: 'deepseek-v4-flash', temperature: 0.2, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Ты — эксперт по тендерам и госзакупкам в инженерно-строительной сфере. Оценивай тендер на основе переданных данных. Не придумывай факты.\\nНАШИ КОМПЕТЕНЦИИ (строго по ним оценивай):\\n1. Проектирование инженерных систем (ОВиК, электрика, водоснабжение/водоотведение)\\n2. Монтаж и пусконаладка вентиляции, кондиционирования, отопления\\n3. Проектирование и монтаж фасадных систем (вентилируемые фасады, светопрозрачные конструкции)\\n4. AI-агенты, автоматизация бизнес-процессов, диспетчеризация\\n5. Производство рекламных видео и графики\\nШКАЛА relevance_score (0-100):\\n- 90-100: Тендер точно по нашему профилю (инженерка/фасады + наш регион + бюджет адекватен).\\n- 70-89: Профиль совпадает, но есть ограничения (география, специфика, малый объём).\\n- 40-69: Частичное совпадение (стройка, но инженерка — лишь часть; или IT без привязки к стройке).\\n- 0-39: Не наш профиль (IT-услуги, поставка оборудования, уборка, охрана, питание).\\nФАКТОРЫ win_probability (от 0.0 до 1.0, считай сумму):\\n- Совпадение профиля с нашими компетенциями: от 0.0 до 0.4\\n- Реалистичность бюджета (не демпинг, не завышен): от 0.0 до 0.2\\n- Достаточность времени на подготовку заявки: от 0.0 до 0.2\\n- Оценка конкуренции (узкая специфика = выше, массовый тендер = ниже): от 0.0 до 0.2\\nИТОГО = сумма. Не ставь 0.9+ без веских оснований в тексте.\\nПРАВИЛА ПОЛЕЙ:\\n- required_prerequisites: КОНКРЕТНЫЕ требования. Примеры: \"СРО на проектирование\", \"Лицензия МЧС\", \"Банковская гарантия 5%\". Не пиши абстракции. Если в тексте требований нет — возвращай [].\\n- summary_ru: РОВНО 3 предложения. 1) Суть тендера (объект, работы). 2) Почему подходит или не подходит нам. 3) Ключевое препятствие или преимущество.\\n- matched_service: ОДНА наиболее подходящая услуга из нумерованного списка выше. Если тендер не релевантен (<40 баллов) — пиши \"Нет подходящей\".\\nВерни СТРОГО валидный JSON по этой структуре:\\n{\\n  \"relevance_score\": number,\\n  \"matched_service\": \"string\",\\n  \"win_probability\": number,\\n  \"required_prerequisites\": [\"string\"],\\n  \"summary_ru\": \"string\"\\n}' }, { role: 'user', content: ($json !== undefined ? JSON.stringify($json).slice(0, 6000) : '{}') } ] }) }}","options":{"timeout":120000,"retryOnFail":true,"maxTries":3,"retryWaitTime":2000}},"id":"1dd9a3f2-1c9d-4e3a-bb72-a10189590e42","name":"DeepSeek Relevance","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2736,144],"credentials":{"httpHeaderAuth":{"id":"R2rXoSacarPbKDqA","name":"DeepSeek API"}},"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const raw=$input.item.json.choices?.[0]?.message?.content||'{}';let p={};try{p=JSON.parse(raw);}catch(e){p={};}const t=$('Parse Tender').item.json;return[{json:{...t,relevance_score:p.relevance_score||0,matched_service:p.matched_service||'',win_probability:p.win_probability||0,required_prerequisites:(p.required_prerequisites||[]).join('; '),summary:p.summary_ru||'',total_score:p.relevance_score||0,scraped_at:new Date().toISOString()}}];"},"id":"21d7ce14-5a39-4c99-81e4-