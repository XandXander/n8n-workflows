    {"parameters":{"jsCode":"const md=($input.item.json.data?.markdown)||$input.item.json.markdown||'';const cur=$('Loop Tenders').context.currentItem?.json||{};const cfg=$('Config').first().json;const budgetM=md.match(/([\\d\\s.,]+)\\s*(?:руб|₽|тыс|млн)/i);let budget=0;if(budgetM&&budgetM[1]){const num=parseInt(budgetM[1].replace(/\\D/g,''),10)||0;if(/млн/i.test(budgetM[0]))budget=num*1000000;else if(/тыс/i.test(budgetM[0]))budget=num*1000;else budget=num;}const deadlineM=md.match(/(?:до|окончани[ея]|deadline)[\\s\\S]{0,50}?(\\d{1,2}[\\.\\/-]\\d{1,2}[\\.\\/-]\\d{2,4})/i);const numberM=md.match(/№\\s*([А-ЯA-Z0-9\\-\\/]{5,})/i);const titleM=md.match(/^#\\s+(.+)$/m);let hostname='unknown';const rawUrl=cur.url||'';const hostMatch=rawUrl.match(/^(?:https?:\\/\\/)?(?:www\\.)?([^\\/]+)/i);if(hostMatch&&hostMatch[1])hostname=hostMatch[1];return[{json:{tender_id:'tnd_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,10),job_id:cfg.job_id,platform:hostname,url:rawUrl,title:titleM?titleM[1]:(cur.title||''),budget:budget,deadline:deadlineM?deadlineM[1]:null,tender_number:numberM?numberM[1]:null,raw_content:md.slice(0,3000)}}];"},"name":"Parse Tender","type":"n8n-nodes-base.code","typeVersion":2,"position":[2304,144]},
