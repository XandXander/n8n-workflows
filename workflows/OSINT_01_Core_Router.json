mber","operation":"gt"}}],"combinator":"and"},"options":{}},"name":"Filter Length","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[6448,1888],"id":"63f02397-d021-4be9-bafe-c87224058780"},{"parameters":{"method":"POST","url":"https://api.deepseek.com/v1/chat/completions","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"},{"name":"Connection","value":"keep-alive"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ model: 'deepseek-v4-flash', temperature: 0.2, max_tokens: 4096, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'You must respond with a JSON object. Ты — классификатор запросов OSINT-платформы. Определи intent (намерение) и извлеки entities (сущности) из запроса пользователя.\\n\\nДОСТУПНЫЕ INTENT:\\n- search_private — поиск частных заявок/лидов (Авито, Юла, Telegram, форумы)\\n- search_b2b — поиск B2B-заказчиков/клиентов\\n- company_analysis — анализ компании по названию/ИНН/сайту\\n- tender_search — поиск тендеров и госзакупок\\n- site_analysis — анализ сайта/URL\\n- deep_osint — комплексный OSINT-поиск\\n\\nПРАВИЛА:\\n- «найди заявки», «найди частные» → search_private\\n- «найди компании», «собери контакты» → company_analysis\\n- «тендер», «закупки», «госзаказ» → tender_search\\n- URL + анализ → site_analysis\\n- B2B, бизнес → search_b2b\\n\\nENTITIES:\\n- service: услуга из запроса (если нет — пустая строка \"\")\\n- region: КОНКРЕТНЫЙ город/регион, явно названный пользователем (например «Пермь», «Москва», «Санкт-Петербург», «Нижний Новгород», «Краснодарский край»). Если пользователь НЕ указал конкретную локацию — верни \"\" (пустую строку). НИКОГДА не подставляй «Россия», «РФ», «вся Россия», «по всей России» и не придумывай локацию.\\n- keywords: 2-5 слов\\n- budget_min/budget_max: числа или null\\n- target_url/inn/name: или null\\n\\nCONFIDENCE: 0.9+ чёткий запрос, 0.5-0.8 неоднозначный.\\n\\nПРИМЕР 1 (явная локация): «Найди 10 частных заявок на создание сайтов в Перми» → { \"intent\": \"search_private\", \"entities\": { \"service\": \"создание сайтов\", \"region\": \"Пермь\", \"keywords\": [\"создание сайтов\", \"разработка\"], \"budget_min\": null, \"budget_max\": null, \"target_url\": null, \"target_inn\": null, \"target_name\": null }, \"confidence\": 0.95 }\\n\\nПРИМЕР 2 (без локации): «Найди 10 частных заявок на создание сайтов» → { \"intent\": \"search_private\", \"entities\": { \"service\": \"создание сайтов\", \"region\": \"\", \"keywords\": [\"создание сайтов\", \"разработка\"], \"budget_min\": null, \"budget_max\": null, \"target_url\": null, \"target_inn\": null, \"target_name\": null }, \"confidence\": 0.95 }' }, { role: 'user', content: ($json !== undefined ? ($json.raw_text || JSON.stringify($json)).slice(0, 4000) : '{}') } ] }) }}","options":{"timeout":45000}},"name":"DeepSeek Intent Classifier","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[6656,1888],"id":"802a5dc6-83dd-41af-aac3-3cc67b28ee86","credentials":{"httpHeaderAuth":{"id":"R2rXoSacarPbKDqA","name":"DeepSeek API"}},"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const prev=$('Normalize Input').first()?.json||{};\nconst job_id=prev.job_id||('job_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,10));\nlet parsedData=null;\nlet parse_error=null;\nconst rawContent=$input.first()?.json?.choices?.[0]?.message?.content;\nif(!rawContent||rawContent.trim()===''){parse_error='CLASSIFIER_EMPTY_RESPONSE';}\nelse{try{const cleanRaw=rawContent.replace(/```json/gi,'').replace(/```/g,'').trim();parsedData=JSON.parse(cleanRaw);}catch(e){parse_error='CLASSIFIER_PARSE_FAILED';}}\nfunction extractRequestedCount(text){\n  const s=String(text||'');\n  const clauses=s.split(/[.;!?,\\n]+/);\n  const found={};\n  for(const clause of clauses){\n    if(!/заяв(?:к|ок)\\S*|лид\\S*|результат\\S*|контакт\\S*/i.test(clause))continue;\n    const ints=clause.match(/\\d+/g);\n    if(!ints)continue;\n    for(const raw of ints){const n=Number(raw);if(Number.isSafeInteger(n)&&n>0){found[n]=true;}}\n  }\n  const vals=Object.keys(found);\n  if(vals.length===0)return{requested_count:null,ambiguous:false};\n  if(vals.length>1)return{requested_count:null,ambiguous:true};\n  return{requested_count:Number(vals[0]),ambiguous:false};\n}\nconst rc=extractRequestedCount(prev.raw_text||'');\nreturn [{json:{\n  job_id:job_id,\n  created_at:new Date().toISOString(),\n  started_at:new Date().toISOString(),\n  source:prev.source||'unknown',\n  origin_channel:prev.origin_channel||null,\n  user_id:prev.user_id||null,\n  chat_id:prev.chat_id||null,\n  requester_email:prev.requester_email||null,\n  raw_text:prev.raw_text||'',\n  intent:(parsedData&&parsedData.intent)?parsedData.intent:'unknown',\n  entities:(parsedData&&parsedData.entities)?parsedData.entities:{},\n  confidence:(parsedData&&typeof parsedData.confidence==='number')?parsedData.confidence:0,\n  parse_error:parse_error,\n  requested_count:rc.requested_count,\n  requested_count_ambiguous:rc.ambiguous,\n  status:'processing'\n}}];"},"name":"Parse Intent","type":"n8n-nodes-base.code","typeVersion":2,"position":[6880,1888],"id":"d9ffd9e0-cade-4d13-ba41-3b8a3f95bb32"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"cc","leftValue":"={{ $json.confidence }}","rightValue":0.3,"operator":{"type":"number","operation":"gte"}}],"combinator":"and"},"options":{}},"name":"Check Parse Success","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[7104,1888],"id":"9f722b7d-86de-45e1-913d-fe1fd4660074"},{"parameters":{"jsCode":"const item=$input.first()?.json||{};\nconst intent=item.intent;\nconst entities=item.entities||{};\nconst region=(entities.region!=null)?String(entities.region).trim():'';\nfunction normRegion(r){return String(r||'').toLowerCase().replace(/ё/g,'е').replace(/ +/g