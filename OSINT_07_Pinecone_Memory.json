{
  "name": "OSINT_07_Pinecone_Memory",
  "nodes": [
    {
      "id": "07000000-0000-4000-8000-000000000001",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 400],
      "parameters": { "inputSource": "passthrough" }
    },
    {
      "id": "07000000-0000-4000-8000-000000000002",
      "name": "Set Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 400],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "operation", "value": "={{ $json.operation }}", "type": "string" },
            { "id": "2", "name": "namespace", "value": "={{ $json.namespace }}", "type": "string" },
            { "id": "3", "name": "text", "value": "={{ $json.text || '' }}", "type": "string" },
            { "id": "4", "name": "vector_id", "value": "={{ $json.id || 'vec_' + Date.now() + '_' + Math.random().toString(36).slice(2,8) }}", "type": "string" },
            { "id": "5", "name": "metadata", "value": "={{ $json.metadata || {} }}", "type": "object" },
            { "id": "6", "name": "top_k", "value": "={{ $json.top_k || 5 }}", "type": "number" },
            { "id": "7", "name": "threshold", "value": "={{ $json.threshold || 0 }}", "type": "number" },
            { "id": "8", "name": "filter", "value": "={{ $json.filter || {} }}", "type": "object" },
            { "id": "9", "name": "pinecone_host", "value": "PLACEHOLDER_PINECONE_HOST", "type": "string" }
          ]
        },
        "options": { "include": "all" }
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000003",
      "name": "Route Operation",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [680, 400],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [ { "id": "c1", "leftValue": "={{ $json.operation }}", "rightValue": "upsert", "operator": { "type": "string", "operation": "equals" } } ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "upsert"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [ { "id": "c2", "leftValue": "={{ $json.operation }}", "rightValue": "query", "operator": { "type": "string", "operation": "equals" } } ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "query"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [ { "id": "c3", "leftValue": "={{ $json.operation }}", "rightValue": "delete", "operator": { "type": "string", "operation": "equals" } } ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "delete"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000004",
      "name": "Jina Embed Passage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 200],
      "parameters": {
        "method": "POST",
        "url": "https://api.jina.ai/v1/embeddings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Content-Type", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"jina-embeddings-v3\",\n  \"task\": \"retrieval.passage\",\n  \"dimensions\": 1024,\n  \"input\": [\"{{ $json.text.replace(/\"/g,'\\\\\"').slice(0,8000) }}\"]\n}",
        "options": {
          "timeout": 30000,
          "retry": { "enabled": true, "maxTries": 3, "waitBetween": 2000 }
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "PLACEHOLDER_JINA", "name": "Jina API" }
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000005",
      "name": "Build Upsert Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1160, 200],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const cfg = $('Set Config').item.json;\nconst emb = $input.item.json.data?.[0]?.embedding;\nif (!emb) { return [{ json: { error: 'no_embedding', raw: $input.item.json } }]; }\nreturn [{ json: {\n  pinecone_host: cfg.pinecone_host,\n  namespace: cfg.namespace,\n  vector_id: cfg.vector_id,\n  body: { vectors: [ { id: cfg.vector_id, values: emb, metadata: cfg.metadata } ], namespace: cfg.namespace }\n}}];"
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000006",
      "name": "Pinecone Upsert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1400, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.pinecone_host }}/vectors/upsert",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Content-Type", "value": "application/json" }, { "name": "X-Pinecone-API-Version", "value": "2024-07" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 30000,
          "retry": { "enabled": true, "maxTries": 3, "waitBetween": 2000 }
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "PLACEHOLDER_PINECONE", "name": "Pinecone API" }
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000007",
      "name": "Return Upsert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1640, 200],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "vector_id", "value": "={{ $('Build Upsert Body').item.json.vector_id }}", "type": "string" },
            { "id": "2", "name": "upserted", "value": true, "type": "boolean" },
            { "id": "3", "name": "namespace", "value": "={{ $('Set Config').item.json.namespace }}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000008",
      "name": "Jina Embed Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 400],
      "parameters": {
        "method": "POST",
        "url": "https://api.jina.ai/v1/embeddings",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Content-Type", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"jina-embeddings-v3\",\n  \"task\": \"retrieval.query\",\n  \"dimensions\": 1024,\n  \"input\": [\"{{ $json.text.replace(/\"/g,'\\\\\"').slice(0,8000) }}\"]\n}",
        "options": {
          "timeout": 30000,
          "retry": { "enabled": true, "maxTries": 3, "waitBetween": 2000 }
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "PLACEHOLDER_JINA", "name": "Jina API" }
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000009",
      "name": "Pinecone Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 400],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Config').item.json.pinecone_host }}/query",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Content-Type", "value": "application/json" }, { "name": "X-Pinecone-API-Version", "value": "2024-07" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ vector: $json.data[0].embedding, topK: $('Set Config').item.json.top_k, namespace: $('Set Config').item.json.namespace, includeMetadata: true, filter: $('Set Config').item.json.filter }) }}",
        "options": {
          "timeout": 30000,
          "retry": { "enabled": true, "maxTries": 3, "waitBetween": 2000 }
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "PLACEHOLDER_PINECONE", "name": "Pinecone API" }
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000010",
      "name": "Filter Matches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 400],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const thr = $('Set Config').item.json.threshold || 0;\nconst matches = ($input.item.json.matches || []).filter(m => m.score >= thr);\nreturn [{ json: { matches, count: matches.length, namespace: $('Set Config').item.json.namespace } }];"
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000011",
      "name": "Pinecone Delete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 600],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.pinecone_host }}/vectors/delete",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Content-Type", "value": "application/json" }, { "name": "X-Pinecone-API-Version", "value": "2024-07" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ids: [$json.vector_id], namespace: $json.namespace }) }}",
        "options": {
          "timeout": 30000,
          "retry": { "enabled": true, "maxTries": 3, "waitBetween": 2000 }
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "PLACEHOLDER_PINECONE", "name": "Pinecone API" }
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000012",
      "name": "Return Delete",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1160, 600],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "deleted", "value": true, "type": "boolean" },
            { "id": "2", "name": "vector_id", "value": "={{ $('Set Config').item.json.vector_id }}", "type": "string" }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Start": { "main": [ [ { "node": "Set Config", "type": "main", "index": 0 } ] ] },
    "Set Config": { "main": [ [ { "node": "Route Operation", "type": "main", "index": 0 } ] ] },
    "Route Operation": {
      "main": [
        [ { "node": "Jina Embed Passage", "type": "main", "index": 0 } ],
        [ { "node": "Jina Embed Query", "type": "main", "index": 0 } ],
        [ { "node": "Pinecone Delete", "type": "main", "index": 0 } ]
      ]
    },
    "Jina Embed Passage": { "main": [ [ { "node": "Build Upsert Body", "type": "main", "index": 0 } ] ] },
    "Build Upsert Body": { "main": [ [ { "node": "Pinecone Upsert", "type": "main", "index": 0 } ] ] },
    "Pinecone Upsert": { "main": [ [ { "node": "Return Upsert", "type": "main", "index": 0 } ] ] },
    "Jina Embed Query": { "main": [ [ { "node": "Pinecone Query", "type": "main", "index": 0 } ] ] },
    "Pinecone Query": { "main": [ [ { "node": "Filter Matches", "type": "main", "index": 0 } ] ] },
    "Pinecone Delete": { "main": [ [ { "node": "Return Delete", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "pinData": {},
  "versionId": "",
  "meta": { "templateCredsSetupCompleted": false },
  "tags": []
}