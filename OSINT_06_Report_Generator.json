    {
      "id": "06000000-0000-4000-8000-000000000004",
      "name": "Read Qualified Entities",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [680, 500],
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "mode": "id", "value": "PLACEHOLDER_SHEET_ID" },
        "sheetName": { "__rl": true, "mode": "name", "value": "={{ $json.entity_type === 'company' ? 'companies' : ($json.entity_type === 'tender' ? 'tenders' : 'leads') }}" },
        "filtersUI": { "values": [ { "lookupColumn": "job_id", "lookupValue": "={{ $json.job_id }}" } ] },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "PLACEHOLDER_GSHEETS", "name": "Google Sheets OAuth2" }
      }
    },
    {
      "id": "06000000-0000-4000-8000-000000000005",
      "name": "Prepare Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 400],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const job = $('Read Job').first()?.json || {};\nconst entities = $('Read Qualified Entities').all().map(i => i.json);\nconst qualified = entities.filter(e => (Number(e.total_score) || 0) >= 60).sort((a,b) => (Number(b.total_score)||0) - (Number(a.total_score)||0)).slice(0, 20);\nconst stats = {\n  total_found: entities.length,\n  qualified: qualified.length,\n  avg_score: entities.length ? Math.round(entities.reduce((s,e)=>s+(Number(e.total_score)||0),0)/entities.length) : 0\n};\nreturn [{ json: { job, entities: qualified, stats, entity_type: $('Set Vars').item.json.entity_type } }];"
      }
    },
    {
      "id": "06000000-0000-4000-8000-000000000006",
      "name": "Groq Generate MD",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1160, 400],
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Content-Type", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama-3.3-70b-versatile', temperature: 0.4, max_tokens: 4000, messages: [ { role: 'system', content: 'Ты аналитик OSINT. Сгенерируй ПРОФЕССИОНАЛЬНЫЙ отчёт на русском в Markdown. Структура: # Отчёт по запросу; ## 1. Резюме; ## 2. Ключевые метрики (таблица); ## 3. Топ-10 (для каждого: название, платформа, контакты, бюджет, скор, почему релевантен, первый месседж); ## 4. Компании/Тендеры (если есть); ## 5. Рекомендации; ## 6. Следующие шаги. Пиши профессионально, конкретно, без воды.' }, { role: 'user', content: JSON.stringify($json).slice(0, 10000) } ] }) }}",
        "options": {
          "timeout": 90000,
          "retry": { "enabled": true, "maxTries": 3, "waitBetween": 3000 }
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "PLACEHOLDER_GROQ", "name": "Groq API" }
      }
    },
    {
      "id": "06000000-0000-4000-8000-000000000007",
      "name": "MD to HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 400],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const md = $input.item.json.choices?.[0]?.message?.content || '';\nfunction mdToHtml(s){\n  let h = s;\n  h = h.replace(/^### (.*)$/gm,'<h3>$1</h3>');\n  h = h.replace(/^## (.*)$/gm,'<h2>$1</h2>');\n  h = h.replace(/^# (.*)$/gm,'<h1>$1</h1>');\n  h = h.replace(/\\*\\*(.+?)\\*\\*/g,'<strong>$1</strong>');\n  h = h.replace(/\\*(.+?)\\*/g,'<em>$1</em>');\n  h = h.replace(/`([^`]+)`/g,'<code>$1</code>');\n  h = h.replace(/^\\|(.+)\\|$/gm,(m)=>{const cells=m.slice(1,-1).split('|').map(c=>c.trim());return '<tr>'+cells.map(c=>'<td>'+c+'</td>').join('')+'</tr>';});\n  h = h.replace(/(<tr>[\\s\\S]+?<\\/tr>)/g,'<table>$1</table>');\n  h = h.replace(/^- (.*)$/gm,'<li>$1</li>');\n  h = h.replace(/(<li>[\\s\\S]+?<\\/li>)/g,'<ul>$1</ul>');\n  h = h.replace(/\\n\\n/g,'</p><p>');\n  return '<p>' + h + '</p>';\n}\nconst body = mdToHtml(md);\nconst jobId = $('Set Vars').item.json.job_id;\nconst date = new Date().toISOString().slice(0,10);\nconst html = `<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><title>OSINT ${jobId}</title><style>body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;max-width:800px;margin:40px auto;padding:20px;color:#222;line-height:1.6}h1{color:#1a365d;border-bottom:2px solid #1a365d;padding-bottom:8px}h2{color:#2c5282;margin-top:32px}h3{color:#2b6cb0}table{border-collapse:collapse;width:100%;margin:16px 0}td,th{border:1px solid #ddd;padding:8px 12px;text-align:left}tr:nth-child(even){background:#f7fafc}code{background:#edf2f7;padding:2px 6px;border-radius:3px;font-family:'SF Mono',Monaco,monospace}ul{padding-left:24px}.footer{margin-top:60px;padding-top:20px;border-top:1px solid #e2e8f0;color:#718096;font-size:12px}</style></head><body>${body}<div class=\"footer\">OSINT Report • Job: ${jobId} • Сгенерировано ${date}</div></body></html>`;\nreturn [{ json: { html, md, filename: `OSINT_${jobId}_${date}.pdf`, job_id: jobId } }];"
      }
    },
    {
      "id": "06000000-0000-4000-8000-000000000008",
      "name": "Gotenberg to PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1640, 400],
      "parameters": {
        "method": "POST",
        "url": "http://gotenberg:3000/forms/chromium/convert/html",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            { "name": "files", "value": "={{ $json.html }}", "parameterType": "formBinaryData", "inputDataFieldName": "index.html" },
            { "name": "paperWidth", "value": "8.27" },
            { "name": "paperHeight", "value": "11.69" }
          ]
        },
        "options": {
          "timeout": 120000,
          "response": { "response": { "responseFormat": "file", "outputPropertyName": "data" } }
        }
      }
    },
    {
      "id": "06000000-0000-4000-8000-000000000009",
      "name": "Upload to Drive",
