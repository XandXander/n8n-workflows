*)\\s*(?:руб|₽|тыс|к\\b|млн)/gi;const budgets=markdown.match(budgetRegex)||[];const title=metadata.title||cur.title||'';const description=markdown.slice(0,500);const contactString=phones.join('')+uniqueTg.join('')+emails.join('');const dedup_hash=generateHash(contactString+title);results.push({json:{lead_id:'lead_'+Date.now().toString(36)+Math.random().toString(36).slice(2,8),job_id:cur.job_id,source_url:cur.url,source_platform:cur.source_platform,title:title,description:description,contact_phone:phones.join('; '),contact_tg:uniqueTg.join('; '),contact_email:emails.join('; '),contact_name:'',region:'',budget:budgets.join('; '),phones_arr:phones,telegrams_arr:uniqueTg,emails_arr:emails,dedup_hash:dedup_hash,scraped_at:new Date().toISOString(),status:'new',total_score:0}});}return results.length>0?results:[{json:{no_results:true,url:cur.url,job_id:cur.job_id}}];"},"id":"70566cc7-36ee-4a2c-a811-43c45c8cbc26","name":"Extract Contacts","type":"n8n-nodes-base.code","typeVersion":2,"position":[1392,1168]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":1},"conditions":[{"id":"cc","operator":{"type":"number","operation":"gt"},"leftValue":"={{ (($json.phones_arr || []).length + ($json.telegrams_arr || []).length + ($json.emails_arr || []).length) }}","rightValue":0}],"combinator":"and"},"options":{}},"id":"3f3f5c15-0387-4a49-b3e1-c17360c6a7d3","name":"Has Contacts?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1616,1168]},{"parameters":{"workflowId":{"__rl":true,"value":"O3Ke6qflNx8CL1x7","mode":"id"},"workflowInputs":{"mappingMode":"defineBelow","value":{"operation":"query","namespace":"leads","text":"={{ $json.title + ' ' + $json.description }}","top_k":3,"threshold":0.92}},"options":{"waitForSubWorkflow":true}},"id":"844d1130-e65d-4cbd-bfac-bcfe7e8e6ec7","name":"Check Duplicate","type":"n8n-nodes-base.executeWorkflow","typeVersion":1.2,"position":[1840,1072],"onError":"continueRegularOutput"},{"par