6448,1888]},{"parameters":{"method":"POST","url":"https://api.deepseek.com/v1/chat/completions","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"},{"name":"Connection","value":"keep-alive"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ model: 'deepseek-v4-flash', temperature: 0.2, max_tokens: 800, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'You must respond with a JSON object. Ты — классификатор запросов OSINT-платформы. Определи intent (намерение) и извлеки entities (сущности) из запроса пользователя.\\n\\nДОСТУПНЫЕ INTENT:\\n- search_private — поиск частных заявок/лидов (Авито, Юла, Telegram, форумы). Ключевые слова: найди, заявки, частные, лиды, поиск.\\n- search_b2b — поиск B2B-заказчиков/клиентов среди бизнеса.\\n- company_analysis — анализ конкретной компании по названию/ИНН/сайту.\\n- tender_search — поиск тендеров и госзакупок.\\n- site_analysis — анализ конкретного сайта/URL.\\n- deep_osint — углублённый OSINT-поиск (комплексный).\\n\\nПРАВИЛА ОПРЕДЕЛЕНИЯ INTENT:\\n- Если пользователь просит «найти», «найди» + упоминает частные заявки, Авито, физлиц, создание сайтов, монтаж, проектирование → search_private.\\n- Если упомянута компания, ИНН, сайт с запросом анализа → company_analysis.\\n- Если запрос про тендеры, закупки, госзаказ → tender_search.\\n- Если только URL и просьба проанализировать → site_analysis.\\n- Если про бизнес-клиентов, B2B → search_b2b.\\n- Если комплексный запрос на нескольких площадках → deep_osint.\\n\\nENTITIES (ВСЕ ПОЛЯ ОБЯЗАТЕЛЬНЫ, НИКОГДА НЕ ВОЗВРАЩАЙ null):\\n- service (string): ВСЕГДА извлекай услугу из запроса. Например: «создание сайтов», «монтаж фасадов», «проектирование вентиляции», «ремонт квартир», «видеонаблюдение». Если услуга не названа явно — определи по контексту. Если совсем неясно — напиши «услуга». НИКОГДА не null.\\n- region (string): город/регион, если указан. Если не указан — «Россия». НИКОГДА не null.\\n- keywords (string[]): 2-5 ключевых слов для поиска. Если не можешь определить — используй слова из service. НИКОГДА не пустой массив.\\n- budget_min/budget_max: числа, если упомянут бюджет. Если нет — null.\\n- target_url: URL если указан. Иначе null.\\n- target_inn: ИНН если указан. Иначе null.\\n- target_name: название компании если указано. Иначе null.\\n\\nCONFIDENCE: от 0.0 до 1.0. 0.9+ если запрос чётко соответствует одному intent. 0.5-0.8 если есть неоднозначность. <0.5 только если запрос совсем неясен.\\n\\nПРИМЕР: для запроса «Найди 10 частных заявок на создание сайтов» верни: { \"intent\": \"search_private\", \"entities\": { \"service\": \"создание сайтов\", \"region\": \"Россия\", \"keywords\": [\"создание сайтов\", \"разработка\", \"сайт\", \"веб\"], \"budget_min\": null, \"budget_max\": null, \"target_url\": null, \"target_inn\": null, \"target_name\": null }, \"confidence\": 0.95 }' }, { role: 'user', content: ($json !== undefined ? JSON.stringify($json).slice(0, 6000) : '{}') } ] }) }}","options":{"timeout":120000,"retryOnFail":true,"maxTries":3,"retryWaitTime":2000}},"name":"DeepSeek Intent Classifier","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[6656,1888],"credentials":{"httpHeaderAuth":{"id":"R2rXoSacarPbKDqA","name":"DeepSeek API"}},"onError":"continueRegularOutput"},{"parameters":{"jsCode":"const resp=$input.first().json;const prev=$('Merge After Voice').first().json;let p;try{const c=resp.choices?.[0]?.message?.content||'{}';p=JSON.parse(c);}catch(e){p={intent:'error',entities:{keywords:[]},confidence:0};}return[{json:{job_id:'job_'+Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,10),created_at:new Date().toISOString(),source:prev.source||'unknown',user_id:prev.user_id||'unknown',chat_id:prev.chat_id||'unknown',raw_text:prev.raw_text||'',intent:p.intent||'error',entities:p.entities||{},confidence:p.confidence||0,status:'proce