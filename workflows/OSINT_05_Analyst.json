      "parameters": {
        "jsCode": "const v=$('Set Job Vars').first().json||{};const xs=$input.all().map(i=>i&&i.json?i.json:{});function nc(x){if(x===null||x===undefined||x==='')return null;const n=Number(x);return Number.isFinite(n)&&n>=0?Math.floor(n):null;}function tb(x){if(x===true||String(x).toLowerCase()==='true')return true;if(x===false||String(x).toLowerCase()==='false')return false;return null;}\nconst accepted=nc(v.accepted_count);const requested=nc(v.requested_count);const agg=tb(v.aggregation_complete);const q=xs.filter(x=>x.status==='quarantined').length;const scored=xs.filter(x=>x.status==='qualified'||x.status==='new').length;const qualified=xs.filter(x=>x.status==='qualified'||Number(x.total_score)>=60).length;const diag={schema_version:'analyst-diagnostics-v5',entities_processed_count:xs.length,scored_count:scored,qualified_scored_count:qualified,quarantined_count:q,entity_missing_count:xs.filter(x=>x.advisory_terminal_status==='ENTITY_MISSING').length,proof_rejected_count:xs.filter(x=>x.advisory_terminal_status==='PROOF_REJECTED').length,update_success_count:xs.filter(x=>x.advisory_terminal_status==='UPDATE_SUCCESS').length,update_error_count:xs.filter(x=>x.advisory_terminal_status==='UPDATE_ERROR').length,update_uncertain_count:xs.filter(x=>x.advisory_terminal_status==='UPDATE_UNCERTAIN').length};const resultMode=accepted!==null&&accepted>0?(agg===true?'scored':'partial_results'):(agg===true?'no_results':'unavailable');\nreturn[{json:{job_id:v.job_id,entity_type:v.entity_type,result_mode:resultMode,accepted_count:accepted,persisted_total:nc(v.persisted_total),selected_count:nc(v.selected_count),report_count:nc(v.report_count),requested_count:requested,shortfall:agg===true?nc(v.shortfall):null,aggregation_complete:agg,qualified_count:qualified,analyst_diagnostics_json:JSON.stringify(diag),search_diagnostics_json:v.search_diagnostics_json??null,private_display_payload_json:v.private_display_payload_json??null,tender_display_payload_json:v.tender_display_payload_jso