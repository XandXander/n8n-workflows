    {
      "parameters": {
        "jsCode": "const item = $input.first();\nif (!item || !item.json) {\n  throw new Error(\"Throttle Check: no input data.\");\n}\n\nconst service = (item.json.service || '').toString().trim();\nif (!service) {\n  throw new Error(\"Throttle Check: 'service' is required.\");\n}\n\nconst limits = {\n  deepseek: 3,\n  groq: 5,\n  serper: 10,\n  tavily: 5,\n  firecrawl: 3,\n  jina: 20\n};\nconst maxRequests = limits[service] || 5;\nconst windowMs = 1000;\n\nconst staticData = this.getWorkflowStaticData('global');\n\nif (!staticData.throttleState) {\n  staticData.throttleState = {};\n}\n\nconst now = Date.now();\nconst state = staticData.throttleState[service] || { windowStart: now, count: 0 };\n\nif (now - state.windowStart > windowMs) {\n  state.windowStart = now;\n  state.count = 0;\n}\n\nif (state.count >= maxRequests) {\n  const retryAfterMs = windowMs - (now - state.windowStart);\n  staticData.throttleState[service] = state;\n  return [{\n    json: {\n      allowed: false,\n      service,\n      limit: maxRequests,\n      current: state.count,\n      retryAfter: Math.max(1, Math.ceil(retryAfterMs / 1000)),\n      windowMs\n    }\n  }];\n}\n\nstate.count++;\nstaticData.throttleState[service] = state;\n\nreturn [{\n  json: {\n    allowed: true,\n    service,\n    limit: maxRequests,\n    current: state.count,\n    remaining: maxRequests - state.count,\n    windowMs\n  }\n}];"
      },
      "name": "Throttle Check",
