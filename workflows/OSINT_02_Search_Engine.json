    {
      "parameters": {
        "jsCode": "const item = $input.first();\nif (!item || !item.json) return [{ json: { skip: true } }];\nconst serperData = item.json;\n\nlet ctx = {};\ntry {\n  const loopItems = $items(\"Loop Queries\", 0, $runIndex);\n  if (loopItems && loopItems.length > 0) ctx = loopItems[0].json || {};\n} catch(e) {\n  try { ctx = $('Loop Queries').item?.json || {}; } catch(e2) {}\n}\n\nconst serperResult = serperData.serperResult || {};\nconst organic = Array.isArray(serperResult.organic) ? serperResult.organic : [];\nconst top3 = organic.slice(0, 3);\nconst results = [];\nfor (const entry of top3) {\n  if (!entry.link) continue;\n  results.push({\n    json: {\n      url: entry.link,\n      title: entry.title || '',\n      snippet: entry.snippet || '',\n      source_platform: ctx.source_platform || 'general',\n      query: ctx.query || '',\n      job_id: ctx.job_id || ''\n    }\n  });\n}\nreturn results.length > 0 ? results : [{ json: { skip: true } }];"
      },
