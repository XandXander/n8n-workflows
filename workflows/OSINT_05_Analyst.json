    {
      "parameters": {
        "jsCode": "// Безопасно получаем входные данные от DeepSeek API\nconst item = $input.first();\nif (!item || !item.json) throw new Error(\"Parse Scores: нет входных данных от DeepSeek API\");\n\n// Парсим JSON-ответ DeepSeek (с очисткой markdown)\nconst raw = item.json.choices?.[0]?.message?.content || '{}';\nlet p = {};\ntry {\n  const cleanRaw = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n  p = JSON.parse(cleanRaw);\n} catch(e) {\n  throw new Error(\"Parse Scores: не удалось распарсить ответ DeepSeek. RAW: \" + raw.slice(0, 200));\n}\n\n// Получаем сущность из текущей итерации Loop Entities (надёжная синхронная ссылка)\nconst loopNode = $('Loop Entities');\nif (!loopNode) throw new Error(\"Parse Scores: узел Loop Entities не найден\");\nconst entity = loopNode.item?.json;\nif (!entity) throw new Error(\"Parse Scores: не удалось получить сущность из Loop Entities (item.json пуст)\");\n\n// Вычисляем скоры\nconst rel = Number(p.relevance_score) || 0;\nconst fresh = Number(p.freshness_score) || 0;\nconst sol = Number(p.solvency_score) || 0;\nconst con = Number(p.contactability_score) || 0;\nconst total = Math.round(0.35 * rel + 0.20 * fresh + 0.25 * sol + 0.20 * con);\n\nreturn [{\n  json: {\n    ...entity,\n    relevance_score: rel,\n    freshness_score: fresh,\n    solvency_score: sol,\n    contactability_score: con,\n    total_score: total,\n    matched_service: p.matched_service || '',\n    why_relevant: p.why_relevant || '',\n    recommended_action: p.recommended_action || '',\n    first_message_draft: p.first_message_draft || '',\n    status: total >= 60 ? 'qualified' : 'new'\n  }\n}];"
      },
      "name": "Parse Scores",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
