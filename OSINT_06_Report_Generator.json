{"id":"qXWixFd94G7Tfgaa","name":"OSINT_06_Report_Generator","nodes":[{"parameters":{},"name":"Start","type":"n8n-nodes-base.executeWorkflowTrigger","typeVersion":1,"position":[-448,112]},{"parameters":{"assignments":{"assignments":[{"id":"1","name":"job_id","value":"={{ $json.job_id }}","type":"string"},{"id":"2","name":"entity_type","value":"={{ $json.entity_type || 'lead' }}","type":"string"}]},"options":{}},"name":"Set Vars","type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-224,112]},{"parameters":{"operation":"read","documentId":{"__rl":true,"mode":"id","value":"1BddnyOBG8Q0BYpXoE0QFkJG2pJi_oxk0aLfJ86IggXA"},"sheetName":{"__rl":true,"mode":"name","value":"jobs"},"filtersUI":{"values":[{"lookupColumn":"job_id","lookupValue":"={{ $json.job_id }}"}]},"options":{}},"name":"Read Job","type":"n8n-nodes-base.googleSheets","typeVersion":4.5,"position":[0,0],"credentials":{"googleSheetsOAuth2Api":{"id":"dUZaJdXfgHXwnmNN","name":"Google Sheets account"}}},{"parameters":{"operation":"read","documentId":{"__rl":true,"mode":"id","value":"1BddnyOBG8Q0BYpXoE0QFkJG2pJi_oxk0aLfJ86IggXA"},"sheetName":{"__rl":true,"mode":"name","value":"={{ $('Set Vars').item.json.entity_type === 'company' ? 'companies' : ($('Set Vars').item.json.entity_type === 'tender' ? 'tenders' : 'leads') }}"},"filtersUI":{"values":[{"lookupColumn":"job_id","lookupValue":"={{ $('Set Vars').item.json.job_id }}"}]},"options":{}},"name":"Read Qualified Entities","type":"n8n-nodes-base.googleSheets","typeVersion":4.5,"position":[0,208],"credentials":{"googleSheetsOAuth2Api":{"id":"dUZaJdXfgHXwnmNN","name":"Google Sheets account"}}},{"parameters":{"jsCode":"const job = $('Read Job').first()?.json || {};\nconst entities = $('Read Qualified Entities').all().map(i => i.json);\nconst qualified = entities.filter(e => (Number(e.total_score) || 0) >= 60).sort((a,b) => (Number(b.total_score)||0) - (Number(a.total_score)||0)).slice(0, 20);\nconst stats = {\n  total_found: entities.length,\n  qualified: qualified.length,\n  avg_score: entities.length ? Math.round(entities.reduce((s,e)=>s+(Number(e.total_score)||0),0)/entities.length) : 0\n};\nreturn [{ json: { job, entities: qualified, stats, entity_type: $('Set Vars').item.json.entity_type } }];"},"name":"Prepare Context","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,112]},{"parameters":{"method":"POST","url":"https://api.deepseek.com/v1/chat/completions","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"},{"name":"Connection","value":"keep-alive"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ model: 'deepseek-v4-flash', temperature: 0.2, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'You are an analyst generating an OSINT report in Russian Markdown. Use only provided data. Return JSON with key markdown_report.' }, { role: 'user', content: ($json !== undefined ? JSON.stringify($json).slice(0, 6000) : '{}') } ] }) }}","options":{"timeout":120000,"retryOnFail":true,"maxTries":3,"retryWaitTime":2000}},"name":"DeepSeek Generate MD","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[480,112],"credentials":{"httpHeaderAuth":{"id":"R2rXoSacarPbKDqA","name":"DeepSeek API"}}},{"parameters":{"jsCode":"const raw = $input.item.json.choices?.[0]?.message?.content || '{}';\nlet parsed;\ntry { parsed = JSON.parse(raw); } catch(e) { parsed = {}; }\nconst md = parsed.markdown_report || raw || '';\nfunction mdToHtml(s){\n  let h = s;\n  h = h.replace(/^### (.*)$/gm,'<h3>$1</h3>');\n  h = h.replace(/^## (.*)$/gm,'<h2>$1</h2>');\n  h = h.replace(/^# (.*)$/gm,'<h1>$1</h1>');\n  h = h.replace(/\\*\\*(.+?)\\*\\*/g,'<strong>$1</strong>');\n  h = h.replace(/\\*(.+?)\\*/g,'<em>$1</em>');\n  h = h.replace(/`([^`]+)`/g,'<code>$1</code>');\n  h = h.replace(/^\\|(.+)\\|$/gm,(m)=>{const cells=m.slice(1,-1).split('|').map(c=>c.trim());return '<tr>'+cells.map(c=>'<td>'+c+'</td>').join('')+'</tr>';});\n  h = h.replace(/(<tr>[\\s\\S]+?<\\/tr>)/g,'<table>$1</table>');\n  h = h.replace(/^- (.*)$/gm,'<li>$1</li>');\n  h = h.replace(/(<li>[\\s\\S]+?<\\/li>)/g,'<ul>$1</ul>');\n  h = h.replace(/\\n\\n/g,'</p><p>');\n  return '<p>' + h + '</p>';\n}\nconst body = mdToHtml(md);\nconst jobId = $('Set Vars').item.json.job_id;\nconst date = new Date().toISOString().slice(0,10);\nconst html = '<!DOCTYPE html><html lang=\"ru\"><head><meta charset=\"utf-8\"><title>OSINT ' + jobId + '</title><style>body{font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;max-width:800px;margin:40px auto;padding:20px;color:#222;line-height:1.6}h1{color:#1a365d;border-bottom:2px solid #1a365d;padding-bottom:8px}h2{color:#2c5282;margin-top:32px}h3{color:#2b6cb0}table{border-collapse:collapse;width:100%;margin:16px 0}td,th{border:1px solid #ddd;padding:8px 12px;text-align:left}tr:nth-child(even){background:#f7fafc}code{background:#edf2f7;padding:2px 6px;border-radius:3px;font-family:SF Mono,Monaco,monospace}ul{padding-left:24px}.footer{margin-top:60px;padding-top:20px;border-top:1px solid #e2e8f0;color:#718096;font-size:12px}</style></head><body>' + body + '<div class=\"footer\">OSINT Report \u2022 Job: ' + jobId + ' \u2022 Generated ' + date + '</div></body></html>';\nreturn [{ json: { html, md, filename: 'OSINT_' + jobId + '_' + date + '.pdf', job_id: jobId } }];"},"name":"MD to HTML","type":"n8n-nodes-base.code","typeVersion":2,"position":[720,112]},{"parameters":{"method":"POST","url":"http://gotenberg:3000/forms/chromium/convert/html","sendBody":true,"contentType":"multipart-form-data","bodyParameters":{"parameters":[{"parameterType":"formBinaryData","name":"files","inputDataFieldName":"index.html"},{"name":"paperWidth","value":"8.27"},{"name":"paperHeight","value":"11.69"}]},"options":{"response":{"response":{"responseFormat":"file"}},"timeout":120000}},"name":"Gotenberg to PDF","type":"n8n-nodes-base.httpRequest","