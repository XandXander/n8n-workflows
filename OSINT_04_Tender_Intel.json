    {"parameters":{"jsCode":"const urls=new Set();const items=[];const allowedDomains=['zakupki.gov.ru','rts-tender.ru','b2b-center.ru','tenderland.ru','tender.pro','roseltorg.ru','sberbank-ast.ru'];const inputItems=$input.all()||[];for(const item of inputItems){if(!item||!item.json)continue;const j=item.json;const organic=j.organic||[];const results=j.results||[];for(const o of organic){const link=o.link;if(!link||urls.has(link))continue;const isTender=allowedDomains.some(d=>link.includes(d));if(isTender){urls.add(link);items.push({json:{url:link,title:o.title||'',snippet:o.snippet||''}});}}for(const r of results){const link=r.url;if(!link||urls.has(link))continue;const isTender=allowedDomains.some(d=>link.includes(d));if(isTender){urls.add(link);items.push({json:{url:link,title:r.title||'',snippet:r.content||''}});}}}return items.slice(0,5).length>0?items.slice(0,5):[{json:{skip:true}}];"},"name":"Extract URLs","type":"n8n-nodes-base.code","typeVersion":2,"position":[1424,48]},
