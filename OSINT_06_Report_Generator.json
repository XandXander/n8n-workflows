            "pdf_drive_url": "={{ $('Upload to Drive').item.json.webViewLink }}",
            "md_content_short": "={{ $('MD to HTML').item.json.md.slice(0,500) }}",
            "email_sent": "={{ $('Read Job').first().json.user_email || 'default' }}"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "PLACEHOLDER_GSHEETS", "name": "Google Sheets OAuth2" }
      }
    },
    {
